{
 "uid": "orders",
 "title": "Order platform",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Outbox backlog (unpublished events)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "outbox_unpublished",
     "legendFormat": "{{application}} {{to}}{{outcome}}{{topic}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Oldest unpublished event age",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "outbox_oldest_age_seconds",
     "legendFormat": "{{application}} {{to}}{{outcome}}{{topic}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Saga transitions per second",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (to) (rate(saga_transition_total[1m]))",
     "legendFormat": "{{application}} {{to}}{{outcome}}{{topic}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Order duration p95 (create to confirmed/cancelled)",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(saga_duration_seconds_bucket[1m])))",
     "legendFormat": "{{application}} {{to}}{{outcome}}{{topic}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Messages parked in DLQ (last 5 min)",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (topic) (increase(kafka_dlq_total[5m]))",
     "legendFormat": "{{application}} {{to}}{{outcome}}{{topic}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Consumer lag (max records behind)",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (application) (kafka_consumer_fetch_manager_records_lag_max)",
     "legendFormat": "{{application}} {{to}}{{outcome}}{{topic}}"
    }
   ]
  }
 ]
}